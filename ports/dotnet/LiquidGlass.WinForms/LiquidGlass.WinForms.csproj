<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Package.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageId>LiquidGlass.WinForms</PackageId>
    <Description>Windows Forms adapter for LiquidGlass: glass over native controls, with backdrops captured from the controls the host owns.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LiquidGlass.Skia/LiquidGlass.Skia.csproj" />
  </ItemGroup>
</Project>
