<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Package.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageId>LiquidGlass.Wpf</PackageId>
    <Description>WPF adapter for LiquidGlass: glass over native WPF content, with backdrops captured from the visuals the host owns and glass drawn into a WriteableBitmap.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LiquidGlass.Skia/LiquidGlass.Skia.csproj" />
  </ItemGroup>
</Project>
