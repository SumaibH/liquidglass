<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LiquidGlass.Skia/LiquidGlass.Skia.csproj" />
    <ProjectReference Include="../LiquidGlass.Avalonia/LiquidGlass.Avalonia.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Avalonia brings the native Skia at 3.119; the painter's managed SkiaSharp is 4.153.1, so its
         native assets must match it. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>
</Project>
